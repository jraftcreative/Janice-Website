---
const base = import.meta.env.BASE_URL;
---

<section class="cta">
  <div class="container cta__inner">
    <p class="cta__label">Ready?</p>
    <h2 class="cta__headline">Not sure where to start?<br />That's what the first meeting is for.</h2>
    <p class="cta__sub">It's free, no strings attached, and takes about an hour.</p>
    <a href={`${base}contact`} class="btn btn--primary cta__btn">Book a Free Consultation</a>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-3xl) 0;
    background: var(--color-light);
  }

  .cta__inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta__label {
    font-size: 0.78rem;
    color: var(--color-accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .cta__headline {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--color-navy);
    margin-bottom: var(--space-sm);
    line-height: 1.25;
  }

  .cta__sub {
    font-size: 1rem;
    color: var(--color-gray);
    margin-bottom: var(--space-lg);
  }

  .cta__btn {
    min-width: 260px;
  }

  @media (max-width: 480px) {
    .cta__btn {
      width: 100%;
    }
  }
</style>
