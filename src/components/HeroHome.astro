---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">Licensed Wealth Manager &middot; Singapore</p>
      <h1 class="hero__headline">
        Helping You<br />
        <span class="hero__accent">Protect What Matters</span>
      </h1>
      <p class="hero__desc">I help Singaporeans build financial plans that actually fit their life — whether you're buying your first BTO, planning for retirement, or protecting your family.</p>
      <div class="hero__cta">
        <a href={`${base}contact`} class="btn btn--primary">Book a Free Consultation</a>
        <a href={`${base}services/wealth-protection`} class="btn btn--outline">Explore Services</a>
      </div>
      <p class="hero__mas">MAS Representative No. LJ-300855233</p>
    </div>
    <div class="hero__photo-wrap">
      <img
        src={`${base}janice.jpg`}
        alt="Janice Low — Licensed Wealth Manager in Singapore"
        class="hero__photo"
        width="480"
        height="600"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-navy);
    color: var(--color-white);
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle 600px at 20% 80%, rgba(42,77,127,0.9) 0%, transparent 60%),
      radial-gradient(circle 500px at 80% 20%, rgba(184,146,63,0.18) 0%, transparent 50%),
      radial-gradient(circle 700px at 50% 50%, rgba(15,40,70,0.7) 0%, transparent 60%);
    animation: heroGradient 10s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: -30%;
    width: 160%;
    height: 160%;
    background:
      radial-gradient(circle 400px at 70% 80%, rgba(184,146,63,0.12) 0%, transparent 50%),
      radial-gradient(circle 500px at 25% 40%, rgba(50,90,150,0.6) 0%, transparent 55%);
    animation: heroGradient2 14s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes heroGradient {
    0% { transform: translate(0%, 0%) rotate(0deg); }
    100% { transform: translate(5%, -5%) rotate(3deg); }
  }

  @keyframes heroGradient2 {
    0% { transform: translate(0%, 0%) rotate(0deg); }
    100% { transform: translate(-4%, 4%) rotate(-2deg); }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: var(--space-2xl);
    align-items: center;
    position: relative;
    z-index: 1;
    padding: 120px 0 80px;
  }

  .hero__eyebrow {
    font-size: 0.82rem;
    color: var(--color-accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .hero__headline {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.01em;
  }

  .hero__accent {
    color: var(--color-accent);
  }

  .hero__desc {
    font-size: 1.05rem;
    color: var(--color-body-dark);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: var(--space-lg);
  }

  .hero__cta {
    display: flex;
    gap: var(--space-sm);
  }

  .hero__mas {
    margin-top: var(--space-lg);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.02em;
  }

  .hero__photo-wrap {
    position: relative;
  }

  .hero__photo {
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: center top;
    border-radius: 1rem;
    box-shadow: 0 24px 60px rgba(0,0,0,0.3);
  }

  .hero__photo-wrap::after {
    content: '';
    position: absolute;
    bottom: -16px;
    left: -16px;
    width: 120px;
    height: 120px;
    border: 2px solid var(--color-accent);
    border-radius: 1rem;
    opacity: 0.2;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      padding: 120px 0 60px;
      text-align: center;
    }
    .hero__photo-wrap {
      order: -1;
      display: flex;
      justify-content: center;
    }
    .hero__photo {
      width: 260px;
      height: 340px;
      border-radius: 0.75rem;
    }
    .hero__photo-wrap::after { display: none; }
    .hero__desc {
      margin-left: auto;
      margin-right: auto;
    }
    .hero__cta {
      flex-direction: column;
      align-items: center;
    }
    .hero__cta .btn { width: 100%; max-width: 320px; text-align: center; }
    .hero__mas { text-align: center; }
  }
</style>
